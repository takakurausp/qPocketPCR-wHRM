{
  "name": "Espressif ESP32-S2 (NATIVE USB, CDC + MSC)",
  "url": "https://docs.espressif.com/projects/esp-idf/en/latest/esp32s2/hw-reference/esp32s2/user-guide-esp32-s2.html",
  "vendor": "Espressif",
  "build": {
    "core": "esp32",
    "variant": "esp32s2",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32s2"
  },
  "connectivity": [
    "wifi"
  ],
  "debug": {
    "openocd_target": "esp32s2.cfg",
    "default_tool": "ftdi"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "upload": {
    "maximum_ram_size": 327680,
    "maximum_size": 4194304,
    "require_upload_port": true,
    "speed": 460800
  }
}
